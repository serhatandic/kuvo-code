{
  "about": "kuvo/config, kuvo/mcp/catalog and kuvo/keys (PROTOCOL.md, \"Settings per box\"): each box's own engine settings, changed as Settings changes them, its popular MCP servers, and its integrations' keys.",
  "scenarios": [
    {
      "name": "the settings read and changed as Settings changes them",
      "steps": [
        { "given": { "settings": { "value": { "model": "anthropic/sonnet" } } } },
        { "send": "GET kuvo/config", "expect": { "status": 200, "json": { "model": "anthropic/sonnet" } } },
        {
          "send": "PATCH kuvo/config",
          "body": { "changes": [ { "path": [ "model" ], "value": "openai/luna" }, { "path": [ "mcp", "servers", "linear", "disabled" ], "value": true } ] },
          "expect": { "status": 200, "json": { "model": "openai/luna", "mcp": { "servers": { "linear": { "disabled": true } } } } }
        },
        { "send": "GET kuvo/config", "expect": { "status": 200, "json": { "model": "openai/luna", "mcp": { "servers": { "linear": { "disabled": true } } } } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "model" ], "value": "x/y", "was": "anthropic/sonnet" } ] }, "expect": { "status": 409, "json": { "message": "It changed since you read it." } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "model" ], "value": null, "was": "openai/luna" } ] }, "expect": { "status": 200, "json": { "model": "<absent>" } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "theme" ], "value": "dark", "was": null } ] }, "expect": { "status": 200, "json": { "theme": "dark" } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "theme", "inner" ], "value": 1 } ] }, "expect": { "status": 400, "json": { "message": "A path goes through objects only; send a list whole, at its own path." } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [] }, "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "model" ] } ] }, "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "PATCH kuvo/config", "body": "not json", "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "PUT kuvo/config", "body": {}, "expect": { "status": 405 } },
        { "send": "GET kuvo/config", "expect": { "status": 200, "json": { "theme": "dark", "mcp": { "servers": { "linear": { "disabled": true } } } } } }
      ]
    },
    {
      "name": "a settings file that isn't plain JSON is left alone, and said to be",
      "steps": [
        { "given": { "settings": { "text": "{\n  // my own\n  \"model\": \"anthropic/sonnet\"\n}\n" } } },
        { "send": "GET kuvo/config", "expect": { "status": 409, "json": { "message": "<string>" } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "model" ], "value": "openai/luna" } ] }, "expect": { "status": 409, "json": { "message": "<string>" } } }
      ]
    },
    {
      "name": "a key named where another computer keeps its keys is named where this box keeps them",
      "steps": [
        {
          "send": "PATCH kuvo/config",
          "body": { "changes": [ { "path": [ "mcp", "servers", "todoist" ], "value": { "type": "local", "environment": { "TODOIST_API_KEY": "{file:/Users/someone/elsewhere/KUVO_KEY_TODOIST_TODOIST_API_KEY}" } } } ] },
          "expect": { "status": 200, "json": { "mcp": { "servers": { "todoist": { "environment": { "TODOIST_API_KEY": "{file:{{keys}}/KUVO_KEY_TODOIST_TODOIST_API_KEY}" } } } } } }
        }
      ]
    },
    {
      "name": "agents, permissions, MCP servers and commands, added, changed and taken out as their pages do it",
      "steps": [
        { "given": { "settings": { "value": { "model": "anthropic/sonnet" } } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "agents", "review" ], "value": { "mode": "subagent", "description": "Reviews code" } } ] },
          "expect": { "status": 200, "json": { "agents": { "review": { "mode": "subagent", "description": "Reviews code" } } } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "agents", "review", "model" ], "value": "openai/luna" }, { "path": [ "agents", "plan", "model" ], "value": "anthropic/haiku" } ] },
          "expect": { "status": 200, "json": { "agents": { "review": { "mode": "subagent", "model": "openai/luna" }, "plan": { "model": "anthropic/haiku" } } } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "default_agent" ], "value": "review" } ] }, "expect": { "status": 200, "json": { "default_agent": "review" } } },
        {
          "send": "PATCH kuvo/config",
          "why": "Settings › Permissions sends its rules and its blocks whole, each at its own path.",
          "body": { "changes": [
            { "path": [ "permissions" ], "value": [ { "action": "shell", "resource": "git push *", "effect": "deny" }, { "action": "edit", "resource": "*", "effect": "ask" } ] },
            { "path": [ "policies" ], "value": [ { "name": "No secrets", "effect": "deny" } ] }
          ] },
          "expect": { "status": 200, "json": { "permissions": [ { "action": "shell", "resource": "git push *", "effect": "deny" }, { "action": "edit", "resource": "*", "effect": "ask" } ], "policies": [ { "name": "No secrets", "effect": "deny" } ] } }
        },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "permissions", "1" ], "value": null } ] }, "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "mcp", "servers", "tools" ], "value": { "type": "local", "command": [ "node", "tools.js" ], "codemode": false } } ] },
          "expect": { "status": 200, "json": { "mcp": { "servers": { "tools": { "type": "local", "command": [ "node", "tools.js" ] } } } } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "mcp", "servers", "tools", "disabled" ], "value": true } ] },
          "expect": { "status": 200, "json": { "mcp": { "servers": { "tools": { "disabled": true, "command": [ "node", "tools.js" ] } } } } } },
        { "send": "PATCH kuvo/config", "body": { "changes": [ { "path": [ "commands", "ship" ], "value": { "template": "Ship $ARGUMENTS", "description": "Ships it" } } ] },
          "expect": { "status": 200, "json": { "commands": { "ship": { "template": "Ship $ARGUMENTS", "description": "Ships it" } } } } },
        {
          "send": "PATCH kuvo/config",
          "why": "Taking out the last of something takes out what it leaves empty.",
          "body": { "changes": [ { "path": [ "mcp", "servers", "tools" ], "value": null }, { "path": [ "commands", "ship" ], "value": null }, { "path": [ "agents", "review" ], "value": null }, { "path": [ "agents", "plan" ], "value": null } ] },
          "expect": { "status": 200, "json": { "mcp": "<absent>", "commands": "<absent>", "agents": "<absent>", "model": "anthropic/sonnet", "default_agent": "review" } }
        }
      ]
    },
    {
      "name": "Also Apply: changes made on another computer, made here as this box has room for them",
      "steps": [
        { "given": { "settings": { "value": { "permissions": [ { "action": "shell", "resource": "docker *", "effect": "deny" } ], "shell": "/bin/bash", "agents": { "build": { "model": "a/b" } } } } } },
        {
          "send": "POST kuvo/config/apply",
          "why": "A look first, which changes nothing: what would be made, the keys it names (for a client to bring along first), what this box hasn't got, what it keeps its own.",
          "body": { "dry": true, "changes": [
            { "path": [ "permissions" ], "before": [], "after": [ { "action": "shell", "resource": "git push *", "effect": "deny" } ] },
            { "path": [ "mcp", "servers", "todoist" ], "after": { "type": "local", "environment": { "TODOIST_API_KEY": "{file:/Users/someone/elsewhere/KUVO_KEY_TODOIST_TODOIST_API_KEY}" } } },
            { "path": [ "shell" ], "before": "/bin/zsh", "after": "/bin/fish" },
            { "path": [ "agents", "review", "model" ], "before": "a/b", "after": "c/d" },
            { "path": [ "agents", "build", "model" ], "before": "a/b", "after": "c/d" },
            { "path": [ "commands", "ship" ], "after": { "template": "Ship it" } }
          ] },
          "expect": { "status": 200, "json": {
            "made": [
              { "path": [ "permissions" ], "value": [ { "action": "shell", "resource": "docker *", "effect": "deny" }, { "action": "shell", "resource": "git push *", "effect": "deny" } ] },
              { "path": [ "mcp", "servers", "todoist" ], "value": { "environment": { "TODOIST_API_KEY": "{file:{{keys}}/KUVO_KEY_TODOIST_TODOIST_API_KEY}" } } },
              { "path": [ "agents", "build", "model" ], "value": "c/d" },
              { "path": [ "commands", "ship" ], "value": { "template": "Ship it" } }
            ],
            "keys": [ "KUVO_KEY_TODOIST_TODOIST_API_KEY" ], "leftOut": [ [ "agents", "review" ] ], "kept": [ [ "shell" ] ], "macOnly": [], "applied": true,
            "settings": { "permissions": [ { "action": "shell", "resource": "docker *", "effect": "deny" } ], "mcp": "<absent>" }
          } }
        },
        { "send": "GET kuvo/config", "expect": { "status": 200, "json": { "mcp": "<absent>", "commands": "<absent>", "agents": { "build": { "model": "a/b" } } } } },
        {
          "send": "POST kuvo/config/apply",
          "body": { "changes": [
            { "path": [ "permissions" ], "before": [], "after": [ { "action": "shell", "resource": "git push *", "effect": "deny" } ] },
            { "path": [ "mcp", "servers", "todoist" ], "after": { "type": "local", "environment": { "TODOIST_API_KEY": "{file:/Users/someone/elsewhere/KUVO_KEY_TODOIST_TODOIST_API_KEY}" } } },
            { "path": [ "shell" ], "before": "/bin/zsh", "after": "/bin/fish" }
          ] },
          "expect": { "status": 200, "json": { "applied": true, "settings": {
            "permissions": [ { "action": "shell", "resource": "docker *", "effect": "deny" }, { "action": "shell", "resource": "git push *", "effect": "deny" } ],
            "mcp": { "servers": { "todoist": { "environment": { "TODOIST_API_KEY": "{file:{{keys}}/KUVO_KEY_TODOIST_TODOIST_API_KEY}" } } } },
            "shell": "/bin/bash"
          } } }
        },
        {
          "send": "POST kuvo/config/apply",
          "why": "A rule taken out there goes here too; the rest of this box's own stay.",
          "body": { "changes": [ { "path": [ "permissions" ], "before": [ { "action": "shell", "resource": "git push *", "effect": "deny" } ], "after": null } ] },
          "expect": { "status": 200, "json": { "settings": { "permissions": [ { "action": "shell", "resource": "docker *", "effect": "deny" } ] } } }
        },
        {
          "send": "POST kuvo/config/apply",
          "why": "Chrome DevTools uses a Mac's own Chrome: another Mac runs it, a machine leaves it out and says so.",
          "body": { "changes": [ { "path": [ "mcp", "servers", "chrome-devtools" ], "after": { "type": "local", "command": [ "kuvo-npx", "chrome-devtools-mcp" ] } } ] },
          "expect": {
            "mac": { "status": 200, "json": { "macOnly": [], "applied": true, "settings": { "mcp": { "servers": { "chrome-devtools": "<object>" } } } } },
            "machine": { "status": 200, "json": { "macOnly": [ "chrome-devtools" ], "made": [], "applied": false, "settings": { "mcp": { "servers": { "chrome-devtools": "<absent>" } } } } }
          }
        },
        { "send": "POST kuvo/config/apply", "body": { "changes": [ { "path": [ "shell" ], "after": "/bin/zsh" } ] }, "expect": { "status": 200, "json": { "made": [], "kept": [ [ "shell" ] ], "applied": false } } },
        { "send": "POST kuvo/config/apply", "body": { "changes": [] }, "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "POST kuvo/config/apply", "body": "not json", "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "GET kuvo/config/apply", "expect": { "status": 405 } }
      ]
    },
    {
      "name": "Also Apply to a settings file that isn't plain JSON: nothing's made, and it says why",
      "steps": [
        { "given": { "settings": { "text": "{\n  // my own\n  \"model\": \"anthropic/sonnet\"\n}\n" } } },
        { "send": "POST kuvo/config/apply", "body": { "changes": [ { "path": [ "model" ], "after": "openai/luna" } ] },
          "expect": { "status": 409, "json": { "message": "<string>", "problem": "It isn't plain JSON, so Kuvo Code leaves it alone. (Comments aren't supported here.)" } } },
        { "send": "GET kuvo/config", "expect": { "status": 409, "json": { "problem": "It isn't plain JSON, so Kuvo Code leaves it alone. (Comments aren't supported here.)" } } }
      ]
    },
    {
      "name": "the popular MCP servers, and adding one as its Add button does",
      "steps": [
        {
          "send": "GET kuvo/mcp/catalog",
          "expect": { "status": 200, "json": { "servers": { "<includes>": [
            { "id": "context7", "title": "Context7", "summary": "<string>", "access": "open", "added": false, "integration": false, "macOnly": false },
            { "id": "linear", "access": "signIn", "added": false }
          ] } } }
        },
        {
          "send": "GET kuvo/mcp/catalog",
          "why": "Chrome DevTools uses the Mac's own Chrome, so a machine's list leaves it out (PROTOCOL.md, kuvo/mcp/catalog).",
          "expect": {
            "mac": { "status": 200, "json": { "servers": { "<includes>": [ { "id": "chrome-devtools", "macOnly": true } ] } } },
            "machine": { "status": 200, "json": { "servers": { "<excludes>": [ { "id": "chrome-devtools" } ] } } }
          }
        },
        { "send": "POST kuvo/mcp/catalog/context7", "expect": { "status": 200, "json": { "mcp": { "servers": { "context7": "<object>" } } } } },
        { "send": "GET kuvo/config", "expect": { "status": 200, "json": { "mcp": { "servers": { "context7": "<object>" } } } } },
        { "send": "GET kuvo/mcp/catalog", "expect": { "status": 200, "json": { "servers": { "<includes>": [ { "id": "context7", "added": true, "integration": false } ] } } } },
        { "send": "POST kuvo/mcp/catalog/context7", "expect": { "status": 200, "json": { "mcp": { "servers": { "context7": "<object>" } } } } },
        { "send": "POST kuvo/mcp/catalog/nothing", "expect": { "status": 404 } },
        { "send": "GET kuvo/mcp/catalog/context7", "expect": { "status": 404 } }
      ]
    },
    {
      "name": "an integration's key: set, listed, read and removed; a bot's own isn't one of these",
      "steps": [
        { "send": "GET kuvo/keys", "expect": { "status": 200, "json": { "keys": { "<excludes>": [ "KUVO_KEY_TODOIST_TODOIST_API_KEY" ] } } } },
        { "send": "PUT kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "body": { "value": "tok_123" }, "expect": { "status": 200, "json": {} } },
        { "send": "GET kuvo/keys", "expect": { "status": 200, "json": { "keys": { "<includes>": [ "KUVO_KEY_TODOIST_TODOIST_API_KEY" ] } } } },
        { "send": "GET kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "expect": { "status": 200, "json": { "value": "tok_123" } } },
        { "send": "PUT kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "body": {}, "expect": { "status": 400, "json": { "message": "Send {\"value\": \"…\"}." } } },
        { "send": "PUT kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "body": { "value": "" }, "expect": { "status": 400, "json": { "message": "Send {\"value\": \"…\"}." } } },
        { "send": "GET kuvo/keys/TODOIST", "expect": { "status": 400, "json": { "message": "That isn't a key's name." } } },
        { "send": "GET kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY__BOT_ADA", "expect": { "status": 400, "json": { "message": "That isn't a key's name." } } },
        { "send": "DELETE kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "expect": { "status": 200, "json": {} } },
        { "send": "GET kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "expect": { "status": 404 } },
        { "send": "DELETE kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "expect": { "status": 200, "json": {} } },
        { "send": "POST kuvo/keys", "expect": { "status": 405 } },
        { "send": "PATCH kuvo/keys/KUVO_KEY_TODOIST_TODOIST_API_KEY", "body": { "value": "x" }, "expect": { "status": 405 } }
      ]
    }
  ]
}
