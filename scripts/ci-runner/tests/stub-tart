#!/bin/bash
# A stand-in for Tart, for the orchestrator's tests. Its state is in $KUVO_TEST_TART (a folder of
# the test's own): every call is noted in calls.log, a VM is a folder in vms/, and these files
# change how it behaves:
#   boot_hangs    `tart exec … /usr/bin/true` never answers
#   stop_fails    `tart stop` fails without stopping the VM
#   runner.sh     what the runner prints (sourced; `say` prints a line, `vm_sleep` waits while
#                 the VM runs and ends the runner when it stops)
#   marker        what the pre-job hook left in the VM (missing: no marker)
set -u
D="${KUVO_TEST_TART:?}"
echo "$*" >> "$D/calls.log"
vm_alive() { [[ -f "$D/run.pid" ]] && kill -0 "$(cat "$D/run.pid")" 2>/dev/null; }
say() { printf '%s\n' "$1"; }
vm_sleep() {
    local i
    for ((i = 0; i < $1 * 10; i++)); do
        vm_alive || exit 1
        sleep 0.1
    done
}
case "$1" in
    --version) echo 2.41.1-stub ;;
    clone) mkdir -p "$D/vms/$3" ;;
    get) [[ -d "$D/vms/$2" ]] ;;
    list) ls "$D/vms" 2>/dev/null ;;
    delete) rm -rf "${D:?}/vms/$2" ;;
    run)
        echo $$ > "$D/run.pid"
        echo "${*:2}" > "$D/run-flags"
        exec sleep 3600
        ;;
    stop)
        [[ ! -e "$D/stop_fails" ]] || exit 1
        if vm_alive; then kill "$(cat "$D/run.pid")"; fi
        ;;
    exec)
        shift
        if [[ "$1" == -i ]]; then
            shift 2
            IFS= read -r jit
            printf '%s\n' "$jit" > "$D/jit-received"
            # shellcheck source=/dev/null
            [[ ! -f "$D/runner.sh" ]] || . "$D/runner.sh"
            exit 0
        fi
        shift
        case "$1" in
            /usr/bin/true)
                [[ ! -e "$D/boot_hangs" ]] || exec sleep 3600
                vm_alive
                ;;
            /bin/cat) vm_alive && cat "$D/marker" 2>/dev/null ;;
            *) exit 1 ;;
        esac
        ;;
    *) exit 1 ;;
esac
