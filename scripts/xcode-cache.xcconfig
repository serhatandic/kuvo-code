// Xcode's compilation cache, one for every checkout's builds: what scripts/xcode-cache.sh hands
// xcodebuild (XCODE_XCCONFIG_FILE), which says why. Its folder and size come from the environment
// (xcodebuild reads environment variables as settings), which xcode_cache sets; without them, a
// build keeps the cache in its own build folder, as Xcode does.
COMPILATION_CACHE_ENABLE_CACHING = YES
COMPILATION_CACHE_CAS_PATH = $(KUVO_XCODE_CAS_PATH:default=$(DERIVED_DATA_DIR)/CompilationCache.noindex)
COMPILATION_CACHE_KEEP_CAS_DIRECTORY = YES
COMPILATION_CACHE_LIMIT_SIZE = $(KUVO_XCODE_CACHE_SIZE:default=20G)
SWIFT_ENABLE_PREFIX_MAPPING = YES
SWIFT_ENABLE_PROJECT_PREFIX_MAPPING = YES
CLANG_ENABLE_PREFIX_MAPPING = YES
CLANG_ENABLE_PROJECT_PREFIX_MAPPING = YES
COMPILER_WORKING_DIRECTORY = $(PROJECT_DIR)
// What's under /tmp or /var by its real path too (#562). Xcode names a checkout there /tmp/…, as
// its project's mapping does, but SwiftPM names a package's sources by the real path,
// /private/tmp/…, which that mapping missed; and a package that also compiles a file Xcode makes
// (resource_bundle_accessor.swift, mapped to /^derived) had some paths mapped and some not. A hit
// that replayed a warning of such a compile crashed Xcode 27.2's build service (SWBBuildService
// aborts in replayCachedDiagnostics: "The Xcode build system has crashed"). Mapped as roots, not
// as /private$(PROJECT_DIR): the compiler names a file by the longest of the paths a mapped one
// came from, and that would be /private/Users/…, which isn't there, for every other checkout. Each
// /tmp checkout keeps keys of its own (/^tmp/its-folder/…), as it had.
SWIFT_OTHER_PREFIX_MAPPINGS = /private/tmp=/^tmp /private/var=/^var
CLANG_OTHER_PREFIX_MAPPINGS = /private/tmp=/^tmp /private/var=/^var
