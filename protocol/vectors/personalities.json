    {
     "removed": [
      {
       "id": "custom.a",
       "removed": 30
      }
     ]
    },
    {
     "personalities": [
      {
       "id": "custom.a",
       "name": "Calm",
       "description": "Words.",
       "symbol": "person.crop.circle",
       "updated": 20
      }
     ]
    }
   ],
   "expected": {
    "personalities": [],
    "removed": [
     {
      "id": "custom.a",
      "removed": 30
     }
    ]
   }
  },
