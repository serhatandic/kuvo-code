{
 "about": "Personalities' libraries met (mergePersonalities in kuvo-link.js, Personalities.merged on the Mac): per personality a removal wins over any change, and stays noted, newest first; otherwise the newest change by its count (`updated`, which each change moves on from the one before it), and at the same count the words that sort last; a count past 2^52 isn't taken.",
 "cases": [
  {
   "name": "the newest change wins",
   "libraries": [
    {
     "personalities": [
      {
       "id": "custom.a",
       "name": "Calm",
       "description": "Old words.",
       "symbol": "person.crop.circle",
       "updated": 10
      }
     ]
    },
    {
     "personalities": [
      {
       "id": "custom.a",
       "name": "Calm",
       "description": "New words.",
       "symbol": "person.crop.circle",
       "updated": 20
      }
     ]
    }
   ],
   "expected": {
    "personalities": [
     {
      "id": "custom.a",
      "name": "Calm",
      "description": "New words.",
      "symbol": "person.crop.circle",
      "updated": 20
     }
    ],
    "removed": []
   }
  },
  {
   "name": "a newer removal wins, and stays noted",
   "libraries": [
    {
     "personalities": [
      {
       "id": "custom.a",
       "name": "Calm",
       "description": "Words.",
       "symbol": "person.crop.circle",
       "updated": 20
      }
     ]
    },
    {
     "removed": [
      {
       "id": "custom.a",
       "removed": 30
      }
     ]
    }
   ],
   "expected": {
    "personalities": [],
    "removed": [
     {
      "id": "custom.a",
      "removed": 30
     }
    ]
   }
  },
  {
   "name": "an older copy doesn't bring a removed one back",
