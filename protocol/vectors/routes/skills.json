{
  "about": "kuvo/skills, kuvo/skill-trash and kuvo/skill-library (PROTOCOL.md, \"Skills\"): each box's own skills folder, written and read as Settings › Skills does, its Recently Deleted, and GitHub's well-known collections. Listing a collection's skills and installing one reach GitHub, which this suite doesn't stand in for: SkillsOnBoxTests (this Mac's box, as the app reaches it) and skills.test.js cover those, each against its own stand-in.",
  "scenarios": [
    {
      "name": "the skills folder, its folders, and which skills came from GitHub",
      "steps": [
        { "given": { "skill": { "name": "release-notes", "text": "---\nname: release-notes\ndescription: Writes the release notes\n---\nKeep them short.\n" } } },
        { "given": { "skill": { "name": "pdf", "text": "---\nname: pdf\n---\nPDFs.\n", "github": { "repository": "anthropics/skills", "path": "skills/pdf" } } } },
        { "send": "GET kuvo/skills", "expect": { "status": 200, "json": { "folder": "{{skills}}", "folders": ["pdf", "release-notes"], "github": { "pdf": { "repository": "anthropics/skills", "path": "skills/pdf" }, "release-notes": "<absent>" } } } }
      ]
    },
    {
      "name": "writing a skill as Settings does: a new one's name, never over another, and one from GitHub stays as it came",
      "steps": [
        { "given": { "skill": { "name": "pdf", "text": "---\nname: pdf\n---\nPDFs.\n", "github": { "repository": "anthropics/skills", "path": "skills/pdf" } } } },
        { "send": "PUT kuvo/skills/release-notes", "body": { "text": "---\nname: release-notes\n---\nKeep them short.\n", "new": true }, "expect": { "status": 200, "json": {} } },
        { "send": "GET kuvo/skills/release-notes", "expect": { "status": 200, "json": { "text": "---\nname: release-notes\n---\nKeep them short.\n" } } },
        { "send": "PUT kuvo/skills/release-notes", "body": { "text": "Again", "new": true }, "expect": { "status": 409, "json": { "message": "There’s a skill called release-notes already." } } },
        { "send": "PUT kuvo/skills/release-notes", "body": { "text": "---\nname: release-notes\n---\nAnd kind.\n" }, "expect": { "status": 200, "json": {} } },
        { "send": "GET kuvo/skills/release-notes", "expect": { "status": 200, "json": { "text": "---\nname: release-notes\n---\nAnd kind.\n" } } },
        { "send": "PUT kuvo/skills/release-notes", "body": { "text": "  " }, "expect": { "status": 400, "json": { "message": "<string>" } } },
        { "send": "PUT kuvo/skills/Release%20Notes", "body": { "text": "Hi", "new": true }, "expect": { "status": 400, "json": { "message": "Names use lowercase letters a to z, digits and hyphens." } } },
        {
          "send": "PUT kuvo/skills/..%2Fescape", "body": { "text": "Hi" },
          "why": "Refused on both: a Mac's link checks every path it hands its box as the relay checks the engine's (403), and a machine's skills route reads the name itself (400).",
          "expect": { "mac": { "status": 403 }, "machine": { "status": 400, "json": { "message": "That isn’t a skill’s name." } } }
        },
        {
          "send": "GET kuvo/skills/%E0%A4%A",
          "why": "Refused on both, as above: a path that doesn't decode.",
          "expect": { "mac": { "status": 403 }, "machine": { "status": 400, "json": { "message": "That isn’t a path." } } }
        },
        { "send": "PUT kuvo/skills/nowhere", "body": { "text": "Hi" }, "expect": { "status": 404, "json": {} } },
        { "send": "PUT kuvo/skills/pdf", "body": { "text": "Mine now" }, "expect": { "status": 409, "json": { "message": "pdf came from GitHub, so it isn’t edited here." } } },
        { "send": "GET kuvo/skills/nowhere", "expect": { "status": 404, "json": {} } }
      ]
    },
    {
      "name": "putting a skill away, and the methods each route takes",
      "steps": [
        { "given": { "skill": { "name": "release-notes", "text": "Keep them short.\n" } } },
        { "send": "DELETE kuvo/skills/release-notes", "expect": { "status": 200, "json": {} } },
        { "send": "GET kuvo/skills/release-notes", "expect": { "status": 404, "json": {} } },
        { "send": "DELETE kuvo/skills/release-notes", "expect": { "status": 404, "json": {} } },
        { "send": "POST kuvo/skills", "expect": { "status": 405, "json": {} } },
        { "send": "PATCH kuvo/skills/release-notes", "expect": { "status": 405, "json": {} } },
        { "send": "GET kuvo/skills/a/b", "expect": { "status": 404, "json": {} } }
      ]
    },
    {
      "name": "Recently Deleted: a skill put away is listed with what its SKILL.md says, restored whole, and never over another by its name",
      "steps": [
        { "given": { "skill": { "name": "release-notes", "text": "---\nname: release-notes\ndescription: Writes the release notes\n---\nKeep them short.\n" } } },
        { "send": "GET kuvo/skill-trash", "expect": { "status": 200, "json": { "entries": [] } } },
        { "send": "DELETE kuvo/skills/release-notes", "expect": { "status": 200, "json": {} } },
        {
          "send": "GET kuvo/skill-trash",
          "expect": { "status": 200, "json": { "entries": [
            { "id": { "<contains>": "release-notes-" }, "folder": "release-notes", "name": "release-notes", "description": "Writes the release notes", "deleted": "<number>", "goes": "<number>" }
          ] } },
          "save": { "entry": "entries.0.id" }
        },
        { "send": "PUT kuvo/skills/release-notes", "body": { "text": "---\nname: release-notes\n---\nA new one.\n", "new": true }, "expect": { "status": 200, "json": {} } },
        { "send": "POST kuvo/skill-trash/{{entry}}/restore", "expect": { "status": 409, "json": { "message": "There’s a skill called release-notes now. Delete it first to restore this one." } } },
        { "send": "GET kuvo/skills/release-notes", "expect": { "status": 200, "json": { "text": "---\nname: release-notes\n---\nA new one.\n" } } },
        { "send": "GET kuvo/skill-trash", "expect": { "status": 200, "json": { "entries": [{ "id": "{{entry}}" }] } } },
        { "send": "DELETE kuvo/skills/release-notes", "expect": { "status": 200, "json": {} } },
        { "send": "POST kuvo/skill-trash/{{entry}}/restore", "expect": { "status": 200, "json": { "name": "release-notes" } } },
        { "send": "GET kuvo/skills/release-notes", "expect": { "status": 200, "json": { "text": "---\nname: release-notes\ndescription: Writes the release notes\n---\nKeep them short.\n" } } },
        { "send": "GET kuvo/skill-trash", "expect": { "status": 200, "json": { "entries": [{ "folder": "release-notes", "description": "<absent>" }] } } },
        { "send": "POST kuvo/skill-trash/{{entry}}/restore", "expect": { "status": 404, "json": {} } }
      ]
    },
    {
      "name": "Recently Deleted keeps an entry 30 days, newest first; its ids are checked, and the methods each route takes",
      "steps": [
        { "given": { "trashedSkill": { "name": "old", "text": "---\nname: old\n---\n", "daysAgo": 31 } } },
        { "given": { "trashedSkill": { "name": "older-but-kept", "text": "---\nname: Older\n---\n", "daysAgo": 29 } } },
        { "given": { "trashedSkill": { "name": "recent", "text": "No header.\n", "daysAgo": 3 } } },
        {
          "send": "GET kuvo/skill-trash",
          "expect": { "status": 200, "json": { "entries": [
            { "folder": "recent", "name": "recent", "description": "<absent>" },
            { "folder": "older-but-kept", "name": "Older" }
          ] } }
        },
        { "send": "POST kuvo/skill-trash/not-an-entry/restore", "expect": { "status": 400, "json": { "message": "That isn’t an entry in Recently Deleted." } } },
        { "send": "POST kuvo/skill-trash/.hidden-1761400000/restore", "expect": { "status": 400, "json": { "message": "That isn’t an entry in Recently Deleted." } } },
        { "send": "POST kuvo/skill-trash/nowhere-1761400000/restore", "expect": { "status": 404, "json": {} } },
        { "send": "POST kuvo/skill-trash", "expect": { "status": 405, "json": {} } },
        { "send": "GET kuvo/skill-trash/nowhere-1761400000/restore", "expect": { "status": 405, "json": {} } }
      ]
    },
    {
      "name": "GitHub's well-known collections, in the same order on both",
      "steps": [
        {
          "send": "GET kuvo/skill-library",
          "expect": { "status": 200, "json": { "repositories": [
            { "id": "anthropics/skills", "owner": "anthropics", "name": "skills", "title": "Anthropic", "summary": "<string>", "branch": "<absent>" },
            { "id": "openai/skills" }, { "id": "obra/superpowers" }, { "id": "mattpocock/skills" }, { "id": "addyosmani/agent-skills" },
            { "id": "vercel-labs/agent-skills" }, { "id": "github/awesome-copilot" }, { "id": "huggingface/skills" }, { "id": "cloudflare/skills" },
            { "id": "trailofbits/skills" }, { "id": "K-Dense-AI/scientific-agent-skills" }, { "id": "wshobson/agents" }
          ] } }
        },
        { "send": "PUT kuvo/skill-library", "expect": { "status": 404, "json": {} } }
      ]
    }
  ]
}
