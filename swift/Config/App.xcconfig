// The app's public identity: its name and bundle ID.
APP_NAME = Kuvo Code
APP_BUNDLE_ID = run.kuvo.code

// Keys Xcode can't generate, merged into the generated Info.plist: folders, so a folder dropped
// on the Dock icon or opened with Kuvo Code becomes a project.
INFOPLIST_FILE = Config/Info.plist

// Signing. Without a local override, builds are signed ad hoc ("-"), which runs on
// this Mac but looks like a new app to macOS after every build, so privacy prompts
// (like Desktop access) come back each time. Put your team in Signing.local.xcconfig
// (git-ignored; see Signing.local.xcconfig.example) to keep one stable identity.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
